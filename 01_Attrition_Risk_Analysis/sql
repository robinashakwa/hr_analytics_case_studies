SELECT
    employee_id,
    department,
    job_role,
    tenure_days,
    salary,
    engagement_score,
    performance_rating,
    is_active,

    -- Attrition flag
    CASE
        WHEN is_active = 0 THEN 1
        ELSE 0
    END AS attrition_flag,

    -- Risk score based on your available columns
    (
        CASE WHEN tenure_days/30 < 24 THEN 20 ELSE 0 END +
        CASE WHEN engagement_score < 50 THEN 30 ELSE 0 END +
        CASE WHEN performance_rating <= 2 THEN 30 ELSE 0 END +
        CASE WHEN salary < 50000 THEN 20 ELSE 0 END
    ) AS risk_score,

    CASE
        WHEN
            (
                CASE WHEN tenure_days/30 < 24 THEN 20 ELSE 0 END +
                CASE WHEN engagement_score < 50 THEN 30 ELSE 0 END +
                CASE WHEN performance_rating <= 2 THEN 30 ELSE 0 END +
                CASE WHEN salary < 50000 THEN 20 ELSE 0 END
            ) >= 70 THEN 'High Risk'
        WHEN
            (
                CASE WHEN tenure_days/30 < 24 THEN 20 ELSE 0 END +
                CASE WHEN engagement_score < 50 THEN 30 ELSE 0 END +
                CASE WHEN performance_rating <= 2 THEN 30 ELSE 0 END +
                CASE WHEN salary < 50000 THEN 20 ELSE 0 END
            ) BETWEEN 40 AND 69 THEN 'Medium Risk'
        ELSE 'Low Risk'
    END AS risk_band

FROM project01_data_cleaned;
